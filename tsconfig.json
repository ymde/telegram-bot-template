{
  "compilerOptions": {
    "lib": [
      "esnext"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": true,
    "strict": true,
    "incremental": true,
    "module": "ESNext",
    "target": "ES2023",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": "src",
    "paths": {
      "@core/*": [
        "*"
      ],
      "@app/*": [
        "app/*"
      ]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/**/*"
  ]
}
