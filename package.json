{
  "name": "shop",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "yarn clean && tsc",
    "dev": "tsc-watch --onSuccess \"yarn start\"",
    "start": "node dist/src/index.js",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.ts": "yarn lint"
  },
  "_moduleAliases": {
    "@core": "dist"
  },
  "dependencies": {
    "@clickhouse/client": "^1.15.0",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.6.0",
    "@grammyjs/i18n": "^1.0.1",
    "@grammyjs/menu": "^1.1.2",
    "@grammyjs/parse-mode": "^2.2.0",
    "@grammyjs/ratelimiter": "^1.1.6",
    "@grammyjs/transformer-throttler": "^1.1.2",
    "@prisma/adapter-mariadb": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "async_hooks": "^1.0.0",
    "dotenv": "^17.2.3",
    "envalid": "^8.1.1",
    "grammy": "^1.11.1",
    "grammy-guard": "^0.5.0",
    "grammy-middlewares": "^1.0.11",
    "lodash": "^4.17.21",
    "module-alias": "^2.2.2",
    "mysql": "^2.18.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.2.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.10"
  },
  "devDependencies": {
    "@prisma/language-server": "^7.0.0",
    "@types/lodash": "^4.14.185",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.1",
    "tsc-watch": "^7.2.0",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3"
  }
}
